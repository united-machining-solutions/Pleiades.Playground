# EditorConfig for Test Projects
# ConfigureAwait(false) is not necessary in test code
# Test method naming convention uses underscores (MethodName_Scenario_ExpectedResult)

[*.cs]
# CA2007: Do not directly await a Task - disabled for test code
dotnet_diagnostic.CA2007.severity = none

# CA1707: Identifiers should not contain underscores - disabled for test method naming convention
dotnet_diagnostic.CA1707.severity = none

# CA1515: Make class internal - disabled because test classes must be public for test discovery
dotnet_diagnostic.CA1515.severity = none

# Deliberately NOT carried over from the sibling test projects: CA2201. Those files suppress it and
# this suite raises no reserved exception type, so copying it would add a suppression that answers
# no finding - which is what the gold standard's rule 30 warns this file must never accumulate.
