          "Scale": 4000.0,
          "NoiseScale": 500.0
        },
        {
          "Topic": "/vendor/Spindle/1/BearingTemperature",
          "Delay": "00:00:02",
          "Unit": "degreeCelsius",
          "NumberOfMessages": -1,
          "GeneratorType": "Sine",
          "Scale": 8.0,
          "Offset": 45.0,
          "Frequency": 0.002,
          "NoiseScale": 0.4
        }
      ]
    },
    "StringValueGeneratorConfig": {
