{
  "extends": "../../../tsconfig.base.json",
  // The card files run in a browser and are built by Vite: they need JSX and the DOM, which the
  // server does not.
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["."]
}
