<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Pleiades.Playground.Bend.Protocol</AssemblyName>
    <RootNamespace>Pleiades.Playground.Bend.Protocol</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Telegrams and file transport of the bending machines (RCI), for both sides: machine and host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
