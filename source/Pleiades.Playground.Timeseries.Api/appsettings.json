{
  "Config": {
    "MongoTimeseries": {
      "ConnectionString": "mongodb://localhost:27018",
      "DatabaseName": "timeseries"
    },
    "Loki": {
      "Sinks": [
        {
          "Name": "Local",
          "Enabled": false,
          "Uri": "http://localhost:3100"
        }
      ]
    },
    "QueryLimits": {
      "DefaultLimit": 10000000,
      "DefaultTimeout": "00:00:30"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
