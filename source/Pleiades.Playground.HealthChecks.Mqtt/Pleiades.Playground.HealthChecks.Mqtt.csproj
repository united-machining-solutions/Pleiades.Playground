    <RootNamespace>Pleiades.Playground.HealthChecks.Mqtt</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Health check for MQTT broker connectivity.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pleiades.Playground.HealthChecks.Mqtt.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pleiades.Playground.Mqtt.Extensions\Pleiades.Playground.Mqtt.Extensions.csproj" />
  </ItemGroup>

</Project>
