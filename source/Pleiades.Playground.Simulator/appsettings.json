        {
          "Topic": "/umati/Connection/Heartbeat",
          "Delay": "00:00:10",
          "Unit": "one",
          "NumberOfMessages": -1,
          "GeneratorType": "Incremental",
          "Scale": 0.1
        },
        {
          "Topic": "/umati/State/FeedOverride",
          "Delay": "00:00:05",
          "Unit": "one",
          "NumberOfMessages": -1,
          "GeneratorType": "Square",
          "LowValue": 0.8,
          "HighValue": 1.0,
          "LowDuration": "00:01:00",
          "HighDuration": "00:04:00"
        },
        {
          "Topic": "/umati/Spindle/1/Override",
          "Delay": "00:00:05",
          "Unit": "one",
          "NumberOfMessages": -1,
          "GeneratorType": "Random",
          "Scale": 0.05,
          "Offset": 0.95
        },
        {
          "Topic": "/umati/OperationCounters/PowerOnDuration",
          "Delay": "00:00:10",
          "Unit": "second",
          "NumberOfMessages": -1,
          "GeneratorType": "Incremental",
          "Scale": 1.0
