# Copy to .env to override. The demo needs no secret; every value below is a default.

# Image tag used for the services built from this repository.
PLEIADES_VERSION=dev
# Version compiled into the .NET services. It must be a version number, for example 0.0.1 or 0.0.1-mybranch.
PLEIADES_BUILD_VERSION=0.0.1

# Third-party images.
MOSQUITTO_VERSION=2
# MongoDB 8.0 does not start on some very recent Linux kernels; pick a newer tag there.
MONGODB_VERSION=8.0
# The LiteLLM gateway of one's own, with the profile "gateway" only (see below).
LITELLM_VERSION=v1.109.1

# Published ports on the host.
MQTT_PORT=1883
MQTT_WS_PORT=9001
TIMESERIES_API_PORT=5500
EVENTS_API_PORT=5510
GENUI_MCP_PORT=5520
APP_PORT=5600
# The address of the host the example app answers on: this computer only. Its chat has no sign-in, so whoever
# reaches the port can chat with the language model below, at the cost of the owner of its key, and read every
# chat. 0.0.0.0 opens the port to the network; do that only in a network you trust.
APP_BIND=127.0.0.1

# How long the services keep data (d.hh:mm:ss).
DATA_RETENTION=30.00:00:00

# The origins a card file of the generative UI backend may load from, separated by commas. A card loads
# nothing of its own. It takes the font of the host that shows it, and a host that serves its font from an
# origin of its own must find that origin here: https://assets.claude.ai for the Claude apps, for example.
# Empty: none, and the card falls back to a system font there.
CARD_RESOURCE_DOMAINS=

# The language models of the chat in the example app. Without them the chat says so; everything else works.
# They come from a LiteLLM gateway, which reaches Anthropic, OpenAI and models of one's own behind one address
# and one key. At the hackathon, the gateway of the hub: its address and key are in the handbook.
# The chat offers the models the gateway marks for chat under GET <LLM_BASE_URL>/models, in its order, and the
# first one answers until a chat picks another. Dictation takes the first model it marks for speech to text.
# The key stays on the server. But everyone who reaches the app can use it through the chat: see APP_BIND.
# More: apps/app/README.md, "Language models".
# LLM_BASE_URL: the address up to /v1, as the app reaches it from its container, where `localhost` is the
# container. A gateway on this computer is http://host.docker.internal:<port>/v1.
# LLM_API_KEY: the key the gateway gave you.
LLM_BASE_URL=
LLM_API_KEY=

# Without the gateway of the hackathon, with a key of Anthropic or of OpenAI: the stack has a LiteLLM gateway
# of its own. Set LLM_BASE_URL=http://litellm:4000/v1, and LLM_API_KEY to a key of your own choosing that
# begins with sk-, which becomes the master key of that gateway; put the key of the provider below, and start
# with docker compose --profile gateway up -d. Its models are in stacks/litellm/config.yaml.
# Without the profile the two lines are not read and nothing is downloaded.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional Ultimaker 3 slicer and MCP service (Compose profile: ultimaker).
# Set COMPOSE_PROFILES=ultimaker on the deployment host to start both services from published images.
# Profiles combine with a comma: COMPOSE_PROFILES=ultimaker,gateway also starts the own LiteLLM gateway.
COMPOSE_PROFILES=
# The chat of the example app gets the tools of an optional service when its MCP server is named here, as
# name=address, separated by commas. The name is the prefix of its tools, the address is the one the app
# reaches from its container: APP_MCP_SERVERS=ultimaker=http://ultimaker-api:8080/mcp
# Name only services whose profile is in COMPOSE_PROFILES. The chat has no sign-in: everyone who reaches the
# app can then use every tool of such a server, also one that starts or orders something. A chat can switch
# such a server off under "Tools" in its message field. A new chat begins as the last one in the same page
# was left, and with all of them after the page is loaded again. Empty: none.
APP_MCP_SERVERS=
# Replace the example URL with the printer address reachable from that host's Docker network.
ULTIMAKER_PRINTER_URL=http://ultimaker.local/
ULTIMAKER_BIND=127.0.0.1
ULTIMAKER_API_PORT=5530
ULTIMAKER_ENABLE_PRINTING=false
ULTIMAKER_SLICE_TIMEOUT_SECOND=180
ULTIMAKER_AUTH_ENABLED=false
ULTIMAKER_AUTH_METADATA_ADDRESS=
ULTIMAKER_AUTH_VALID_ISSUER=
ULTIMAKER_AUTH_AUDIENCE=
ULTIMAKER_MACHINE_ID=UM3-01
ULTIMAKER_POLL_INTERVAL_SECOND=2
ULTIMAKER_MQTT_URL=mqtt://broker:1883
ULTIMAKER_MQTT_USER=
ULTIMAKER_MQTT_PASSWORD=
