{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information",
        "System": "Warning",
        "Opc.Ua": "Warning"
      }
    }
  },
  "Config": {
    "MqttDestination": {
      "ConnectionString": "mqtt://localhost:1883",
      "User": "",
      "Password": "",
      "UseTls": false
    },
    "DataDirectory": "/data",
    "HeartbeatInterval": "00:00:10",
    "SamplingInterval": "00:00:00.500",
    "ApplicationUri": "urn:pleiades:playground:opcua:adapter",
    "Loki": {
      "Sinks": [
        {
          "Name": "Local",
          "Enabled": false,
          "Uri": "http://localhost:3100"
        }
      ]
    }
  }
}
