<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Pleiades.Playground.HealthChecks.MongoDb</AssemblyName>
    <RootNamespace>Pleiades.Playground.HealthChecks.MongoDb</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Health check for MongoDB connectivity.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pleiades.Playground.HealthChecks.MongoDb.Test" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
