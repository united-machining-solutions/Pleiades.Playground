# Containers are Linux: keep LF everywhere so scripts and configs never carry CR into an image.
* text=auto eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.pdf binary
# The voice of Tom (apps/titan-voice) and his recording: large binaries, kept in Git LFS.
*.onnx filter=lfs diff=lfs merge=lfs -text
apps/titan-voice/**/*.wav filter=lfs diff=lfs merge=lfs -text
