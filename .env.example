# Copy to .env to override. The demo needs no secret; every value below is a default.

# Image tag used for the services built from this repository.
PLEIADES_VERSION=dev
# Version compiled into the .NET services. It must be a version number, for example 0.0.1 or 0.0.1-mybranch.
PLEIADES_BUILD_VERSION=0.0.1

# Third-party images.
MOSQUITTO_VERSION=2
# MongoDB 8.0 does not start on some very recent Linux kernels; pick a newer tag there.
MONGODB_VERSION=8.0

# Published ports on the host.
MQTT_PORT=1883
MQTT_WS_PORT=9001
TIMESERIES_API_PORT=5500
EVENTS_API_PORT=5510
GENUI_MCP_PORT=5520
APP_PORT=5600
# The address of the host the example app answers on: this computer only. Its chat has no sign-in, so whoever
# reaches the port can chat with the language model below, at the cost of the owner of its key, and read every
# chat. 0.0.0.0 opens the port to the network; do that only in a network you trust.
APP_BIND=127.0.0.1

# How long the services keep data (d.hh:mm:ss).
DATA_RETENTION=30.00:00:00

# The origins a card file of the generative UI backend may load from, separated by commas. A card loads
# nothing of its own. It takes the font of the host that shows it, and a host that serves its font from an
# origin of its own must find that origin here: https://assets.claude.ai for the Claude apps, for example.
# Empty: none, and the card falls back to a system font there.
CARD_RESOURCE_DOMAINS=

# The language models of the chat in the example app. Every block is optional. The chat offers each
# model that is named, several of them separated by commas, and the first one answers until a chat
# picks another. Without any model the chat says so; everything else works.
# The keys stay on the server. But everyone who reaches the app can use them through the chat: see APP_BIND.
# The model names below are those of November 2026, the least expensive first; a block counts only once its
# key is set. Names change: see the model pages of the providers. `compose.yaml` uses the same names when a
# line of names is missing or empty, so a key alone is enough.
# The blocks count in the order below: with several keys set, the first model of the first block answers.

# Anthropic: a key and the names of its models.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5,claude-fable-5-2

# OpenAI: a key and the names of its models.
OPENAI_API_KEY=
OPENAI_MODELS=gpt-6-luna,gpt-6.1-sol,gpt-6-astra

# Any other endpoint that speaks OpenAI's chat completions, for example a local model server or a
# gateway: its address, its models, and a key if it wants one.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELS=
