# Copy to .env to override. The demo needs no secret; every value below is a default.

# Image tag used for the services built from this repository.
PLEIADES_VERSION=dev

# Third-party images.
MOSQUITTO_VERSION=2
# MongoDB 8.0 does not start on some very recent Linux kernels; pick a newer tag there.
MONGODB_VERSION=8.0

# Published ports on the host.
MQTT_PORT=1883
MQTT_WS_PORT=9001
TIMESERIES_API_PORT=5500
EVENTS_API_PORT=5510
GENUI_MCP_PORT=5520
APP_PORT=5600

# How long the services keep data (d.hh:mm:ss).
DATA_RETENTION=30.00:00:00

# The language models of the chat in the example app. Every block is optional. The chat offers each
# model that is named, several of them separated by commas, and the first one answers until a chat
# picks another. Without any model the chat says so; everything else works.

# OpenAI: a key and the names of its models.
OPENAI_API_KEY=
OPENAI_MODELS=

# Anthropic: a key and the names of its models.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=

# Any other endpoint that speaks OpenAI's chat completions, for example a local model server or a
# gateway: its address, its models, and a key if it wants one.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELS=
