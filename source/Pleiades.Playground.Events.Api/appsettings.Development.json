{
  "Config": {
    "Auth": {
      "Enabled": false
    },
    "MongoDb": {
      "ConnectionString": "mongodb://localhost:27018",
      "DataRetentionPeriod": "5.00:00:00"
    },
    "Loki": {
      "Sinks": [
        {
          "Name": "Local",
          "Enabled": false,
          "Uri": "http://localhost:3100"
        }
      ]
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Information"
      }
    }
  }
}

