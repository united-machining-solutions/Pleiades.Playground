{
  "Config": {
    "Topics": [
      "machines/+/umati/#",
      "machines/+/oem/#",
      "machines/+/events/+",
      "sites/+/#"
    ],
    "ForwardRetained": true,
    "MqttSource": {
      "ConnectionString": "mqtt://localhost:1883",
      "ClientId": "nats-bridge",
      "CleanSession": false,
      "SessionExpiry": "1.00:00:00",
      "User": "",
      "Password": "",
      "UseTls": false
    },
    "Nats": {
      "Url": "nats://localhost:4222",
      "SubjectPrefix": "local.pleiades",
      "JetStream": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting": "Information",
        "System": "Warning",
        "NATS": "Warning"
      }
    }
  }
}
