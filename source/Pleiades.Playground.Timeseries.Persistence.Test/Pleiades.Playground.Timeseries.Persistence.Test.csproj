<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <AssemblyName>Pleiades.Playground.Timeseries.Persistence.Test</AssemblyName>
    <RootNamespace>Pleiades.Playground.Timeseries.Persistence.Test</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.test.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Pleiades.Playground.Timeseries.Persistence\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pleiades.Playground.Timeseries.Persistence\Pleiades.Playground.Timeseries.Persistence.csproj" />
  </ItemGroup>

</Project>
